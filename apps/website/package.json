{
  "name": "typed-website",
  "version": "0.0.0",
  "private": true,
  "description": "Typed marketing, reference, and agent documentation website",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm docs:generate && pnpm build:static",
    "clean:dist": "tsx scripts/clean-dist.ts",
    "build:static": "pnpm build:storybook && astro sync --force && astro build",
    "start": "astro preview",
    "docs:dependencies": "node node_modules/typescript-compiler/bin/tsc6 -b ../../tsconfig.build.json && pnpm --filter @typed/svelte build:components",
    "docs:generate": "pnpm docs:dependencies && tsx scripts/generate-docs.ts",
    "test": "pnpm test:production",
    "test:docs": "pnpm docs:dependencies && vitest run --config vitest.config.ts src/docs/__tests__ src/site/__tests__",
    "test:production": "pnpm build && pnpm test:static",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "dev": "pnpm docs:generate && pnpm build:storybook && astro sync --force && astro dev",
    "preview": "astro preview",
    "test:static": "node --test test/production-smoke.test.mjs test/static-links.test.mjs test/reference-layout.test.mjs test/marble-playback.test.mjs test/storybook-embed.test.mjs test/search-experience.test.mjs test/curriculum-navigation.test.mjs && node --test test/page-layouts.test.mjs",
    "format:astro": "prettier --plugin prettier-plugin-astro --write \"src/site/**/*.astro\"",
    "build:storybook": "pnpm --filter @typed/ui exec storybook build --output-dir ../../apps/website/public/storybook --disable-telemetry"
  },
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@typed/astro": "workspace:*",
    "@typed/async-data": "workspace:*",
    "@typed/fx": "workspace:*",
    "@typed/guard": "workspace:*",
    "@typed/id": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/react": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/svelte": "workspace:*",
    "@typed/template": "workspace:*",
    "@typed/ui": "workspace:*",
    "@typed/vue": "workspace:*",
    "astro": "7.3.1",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@tailwindcss/vite": "^4.3.3",
    "@typed/tsconfig": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "daisyui": "^5.7.28",
    "happy-dom": "catalog:",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "catalog:",
    "svelte2tsx": "0.7.61",
    "tailwindcss": "^4.3.3",
    "tsx": "catalog:",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-compiler": "npm:@typescript/typescript6@6.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.42"
  }
}
