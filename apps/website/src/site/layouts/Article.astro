---
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import MarbleContents from "../components/MarbleContents.astro";
import ContributeDocs from "../components/ContributeDocs.astro";
import { siteHref } from "../../SiteHref.js";

interface Props {
  title: string;
  summary: string;
  section: string;
  kind?: "concept" | "guide" | "deep-dive" | "reference";
  current?: string;
  index?: { href: string; title: string };
  headings?: readonly { depth: number; slug: string; text: string }[];
  source?: string;
  contributionSources?: readonly { path: string; label?: string }[];
  previous?: { href: string; title: string };
  next?: { href: string; title: string };
}
const {
  title,
  summary,
  section,
  kind,
  current,
  index = { href: "/explore", title: "All guides" },
  headings = [],
  source,
  contributionSources = source ? [{ path: source }] : [],
  previous,
  next,
} = Astro.props;
---

<Base title={title} description={summary}>
  <div class="docs-layout">
    <aside class="docs-sidebar"><Sidebar current={current} /></aside>
    <main class="docs-content" id="main-content" tabindex="-1">
      <details class="mobile-nav">
        <summary>Browse documentation</summary><Sidebar current={current} />
      </details>
      <header class="page-intro">
        <p class="eyebrow">
          {section}{
            kind === "reference"
              ? " / Reference"
              : kind === "deep-dive"
                ? " / Deep dive"
                : ""
          }
        </p><h1 class="page-title">{title}</h1><p>
          {summary}
        </p>
      </header>
      {
        current === "fx-operator-atlas" && (
          <MarbleContents headings={headings} />
        )
      }
      <article class="prose"><slot /></article>
      {
        contributionSources.length > 0 && (
          <ContributeDocs sources={contributionSources} />
        )
      }
      <nav class="article-footer" aria-label="Continue learning">
        {
          previous ? (
            <a href={siteHref(previous.href)}>← {previous.title}</a>
          ) : (
            <a href={siteHref(index.href)}>← {index.title}</a>
          )
        }
        {next && <a href={siteHref(next.href)}>{next.title} →</a>}
      </nav>
    </main>
    <nav class="toc" aria-label="On this page">
      <h2>On this page</h2>
      {
        current === "fx-operator-atlas" ? (
          <MarbleContents headings={headings} sidebar />
        ) : (
          headings
            .filter(({ depth }) => depth < 4)
            .map(({ slug, text, depth }) => (
              <a href={`#${slug}`} class={`depth-${depth}`}>
                {text}
              </a>
            ))
        )
      }
      {
        source && (
          <a
            class="source-link"
            href={`https://github.com/TylorS/typed/blob/development/apps/website/${source}`}
          >
            {source.endsWith(".md") ? "Read the Markdown" : "View source"} ↗
          </a>
        )
      }
      <a href="https://effect.website/docs/v4/">Effect documentation ↗</a>
    </nav>
  </div>
</Base>
