---
import Base from "../layouts/Base.astro";
import { siteHref } from "../../SiteHref.js";
---

<Base
  title="Page not found"
  description="Find your way back to the Typed guides and API reference."
>
  <main class="page-container" id="main-content" tabindex="-1">
    <header class="page-intro">
      <p class="eyebrow">404 / NOTHING AT THIS ADDRESS</p>
      <h1 class="page-title">Page not found.</h1>
      <p>
        This address may have changed. Use search to find a page, or browse the
        guides and API reference below.
      </p>
    </header>
    <div class="hero-actions">
      <a class="btn btn-primary" href={siteHref("/explore")}>
        Browse guides
      </a>
      <a class="btn btn-outline" href={siteHref("/reference")}>
        API reference
      </a>
    </div>
  </main>
</Base>
