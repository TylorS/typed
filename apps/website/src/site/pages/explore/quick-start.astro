---
import { getCollection, render } from "astro:content";
import { adjacentLinks, learningGroups } from "../../Guides.js";
import Article from "../../layouts/Article.astro";
import Demo from "../../components/CurriculumDemo.js";
import { siteHref } from "../../../SiteHref.js";
import {
  counterLessonPath,
  isQuickStartSection,
} from "../../../tutorial/Routes.js";
const navigation = adjacentLinks(
  "quick-start",
  learningGroups(
    await getCollection("guides"),
    await getCollection("learn"),
    await getCollection("tutorial"),
  ),
);
const sections = await Promise.all(
  (await getCollection("learn"))
    .filter((entry) => isQuickStartSection(entry.data.id))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const headings = sections.map(({ entry }) => ({
  depth: 2,
  slug: entry.data.id,
  text: entry.data.title,
}));
---

<Article
  title="Build a counter"
  summary="Two files and a few commands. Click the counter, then make it your own."
  section="QUICK START"
  current="quick-start"
  headings={headings}
  contributionSources={sections.map(({ entry }) => ({
    path: `content/learn/${entry.id}.md`,
    label: `Edit “${entry.data.title}”`,
  }))}
  {...navigation}
>
  <Demo id="counter-reactive" client:load />
  {
    sections.map(({ entry, Content }) => (
      <section aria-labelledby={entry.data.id}>
        <h2 id={entry.data.id}>{entry.data.title}</h2>
        <Content />
      </section>
    ))
  }
  <h2>Make one value follow another</h2>
  <p id="component-lifetime">
    Next, <a href={siteHref(counterLessonPath("component-lifetime"))}
      >derive a value from the count</a
    >. Then build the <a href={siteHref("/explore/tutorial")}>Todo app</a> to practice
    forms, keyed lists and persistence.
  </p>
  <details>
    <summary>Optional: inspect mounting or add server rendering</summary>
    <p id="client-only">
      To inspect mounting, <a href={siteHref(counterLessonPath("client-only"))}
        >start with a plain template</a
      >.
    </p>
    <p id="server-html">
      <a href={siteHref(counterLessonPath("server-html"))}
        >Render the counter on the server</a
      >, then <a
        id="hydrate-state"
        href={siteHref(counterLessonPath("hydrate-state"))}
        >restore its state in the browser</a
      >. This is a separate path; TodoMVC stays client-side.
    </p>
  </details>
</Article>
