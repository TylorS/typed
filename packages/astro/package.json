{
  "name": "@typed/astro",
  "version": "1.0.0-beta.10",
  "description": "Astro integration for Typed HTML templates and hydrated islands.",
  "keywords": [
    "astro-integration",
    "effect",
    "typed"
  ],
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/astro#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/astro"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Component": {
      "types": "./dist/Component.d.ts",
      "import": "./dist/Component.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "pnpm run test:node && pnpm run test:browser && pnpm run test:types",
    "test:node": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:integration": "pnpm run build && node test.integration.mjs"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/template": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@typed/ui": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "astro": "^7.3.1",
    "happy-dom": "catalog:",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.3.1"
  }
}
