{
  "name": "@typed/guard",
  "version": "1.0.0-beta.9",
  "description": "Composable Effect-based guards for validation, parsing, and route matching.",
  "keywords": [
    "effect",
    "guard",
    "parsing",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/guard#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/guard"
  },
  "files": [
    "dist",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./getGuard": {
      "types": "./dist/getGuard.d.ts",
      "import": "./dist/getGuard.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "tsc -p tsconfig.types.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
