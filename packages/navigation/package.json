{
  "name": "@typed/navigation",
  "version": "1.0.0-beta.9",
  "description": "Navigation state and browser history integration for Typed applications.",
  "license": "MIT",
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/navigation#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/navigation"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Blocking": {
      "types": "./dist/Blocking.d.ts",
      "import": "./dist/Blocking.js"
    },
    "./Navigation": {
      "types": "./dist/Navigation.d.ts",
      "import": "./dist/Navigation.js"
    },
    "./_core": {
      "types": "./dist/_core.d.ts",
      "import": "./dist/_core.js"
    },
    "./fromWindow": {
      "types": "./dist/fromWindow.d.ts",
      "import": "./dist/fromWindow.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "pnpm run build && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/id": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
