{
  "name": "@typed/router",
  "version": "1.0.0-beta.8",
  "description": "Typed routing, matchers, and route execution for Typed applications.",
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/router#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/router"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AST": {
      "types": "./dist/AST.d.ts",
      "import": "./dist/AST.js"
    },
    "./CurrentRoute": {
      "types": "./dist/CurrentRoute.d.ts",
      "import": "./dist/CurrentRoute.js"
    },
    "./Matcher": {
      "types": "./dist/Matcher.d.ts",
      "import": "./dist/Matcher.js"
    },
    "./Parser": {
      "types": "./dist/Parser.d.ts",
      "import": "./dist/Parser.js"
    },
    "./Path": {
      "types": "./dist/Path.d.ts",
      "import": "./dist/Path.js"
    },
    "./Route": {
      "types": "./dist/Route.d.ts",
      "import": "./dist/Route.js"
    },
    "./RouteExecutor": {
      "types": "./dist/RouteExecutor.d.ts",
      "import": "./dist/RouteExecutor.js"
    },
    "./Router": {
      "types": "./dist/Router.d.ts",
      "import": "./dist/Router.js"
    },
    "./RouterTest": {
      "types": "./dist/RouterTest.d.ts",
      "import": "./dist/RouterTest.js"
    },
    "./TypeFunction": {
      "types": "./dist/TypeFunction.d.ts",
      "import": "./dist/TypeFunction.js"
    },
    "./Uri": {
      "types": "./dist/Uri.d.ts",
      "import": "./dist/Uri.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "test": "pnpm run test:node && pnpm run test:browser && pnpm run test:types",
    "test:node": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/guard": "workspace:*",
    "@typed/id": "workspace:*",
    "@typed/navigation": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
