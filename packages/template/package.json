{
  "name": "@typed/template",
  "version": "1.0.0-beta.10",
  "description": "Typed HTML templates, rendering, and hydration for Typed applications.",
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/template#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/template"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Component": {
      "types": "./dist/Component.d.ts",
      "import": "./dist/Component.js"
    },
    "./EventHandler": {
      "types": "./dist/EventHandler.d.ts",
      "import": "./dist/EventHandler.js"
    },
    "./EventSource": {
      "types": "./dist/EventSource.d.ts",
      "import": "./dist/EventSource.js"
    },
    "./Html": {
      "types": "./dist/Html.d.ts",
      "import": "./dist/Html.js"
    },
    "./HtmlChunk": {
      "types": "./dist/HtmlChunk.d.ts",
      "import": "./dist/HtmlChunk.js"
    },
    "./HydrateContext": {
      "types": "./dist/HydrateContext.d.ts",
      "import": "./dist/HydrateContext.js"
    },
    "./Parser": {
      "types": "./dist/Parser.d.ts",
      "import": "./dist/Parser.js"
    },
    "./Render": {
      "types": "./dist/Render.d.ts",
      "import": "./dist/Render.js"
    },
    "./Renderable": {
      "types": "./dist/Renderable.d.ts",
      "import": "./dist/Renderable.js"
    },
    "./RenderEvent": {
      "types": "./dist/RenderEvent.d.ts",
      "import": "./dist/RenderEvent.js"
    },
    "./RootEvents": {
      "types": "./dist/RootEvents.d.ts",
      "import": "./dist/RootEvents.js"
    },
    "./RootIdentity": {
      "types": "./dist/RootIdentity.d.ts",
      "import": "./dist/RootIdentity.js"
    },
    "./RenderQueue": {
      "types": "./dist/RenderQueue.d.ts",
      "import": "./dist/RenderQueue.js"
    },
    "./RenderTemplate": {
      "types": "./dist/RenderTemplate.d.ts",
      "import": "./dist/RenderTemplate.js"
    },
    "./Template": {
      "types": "./dist/Template.d.ts",
      "import": "./dist/Template.js"
    },
    "./Wire": {
      "types": "./dist/Wire.d.ts",
      "import": "./dist/Wire.js"
    },
    "./many": {
      "types": "./dist/many.d.ts",
      "import": "./dist/many.js"
    },
    "./WebComponent": {
      "types": "./dist/WebComponent.d.ts",
      "import": "./dist/WebComponent.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "pnpm run test:node && pnpm run test:browser && pnpm run test:types",
    "test:node": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:types": "pnpm run build && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/id": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
