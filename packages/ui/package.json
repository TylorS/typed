{
  "name": "@typed/ui",
  "version": "1.0.0-beta.7",
  "description": "Web integration for Typed routing, templates, and Effect HTTP.",
  "homepage": "https://github.com/TylorS/typed/tree/development/packages/ui#readme",
  "bugs": "https://github.com/TylorS/typed/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylorS/typed.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc",
    "test": "pnpm run test:types && pnpm run test:node && pnpm run test:browser && pnpm run test:storybook",
    "test:node": "vitest run --config vitest.config.ts --project=node",
    "test:browser": "vitest run --config vitest.browser.config.ts --project firefox --no-file-parallelism && vitest run --config vitest.browser.config.ts --project chromium && vitest run --config vitest.browser.config.ts --project webkit",
    "test:types": "tsc -p tsconfig.type-tests.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.stories.json",
    "storybook": "storybook dev --ci --port 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "vite preview --outDir storybook-static --port 6007 --strictPort",
    "test:storybook": "vitest run --config vitest.config.ts --project=storybook",
    "test:storybook:coverage": "vitest run --config vitest.config.ts --project=storybook --coverage",
    "test:a11y": "pnpm run test:storybook"
  },
  "dependencies": {
    "@typed/fx": "workspace:*",
    "@typed/id": "workspace:*",
    "@typed/navigation": "workspace:*",
    "@typed/router": "workspace:*",
    "@typed/template": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "daisyui": "^5.7.28",
    "happy-dom": "catalog:",
    "playwright": "^1.62.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
