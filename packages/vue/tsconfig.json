{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["DOM", "ES2024", "ESNext.Disposable"],
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.type-test.ts",
    "**/*.type-test.tsx",
    "src/__tests__/helpers/**"
  ],
  "references": [
    { "path": "../id" },
    {
      "path": "../fx"
    },
    {
      "path": "../template"
    },
    {
      "path": "../async-data"
    },
    {
      "path": "../navigation"
    },
    {
      "path": "../router"
    }
  ]
}
